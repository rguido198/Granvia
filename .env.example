# ── Gate público del sitio (/acceso-privado) ───────────────────────────────────
# Contraseña compartida que desbloquea el sitio entero para cualquier visitante,
# y secreto de firma de la cookie de acceso.
#
# Genera SITE_SESSION_SECRET (32 bytes aleatorios) con:
#   openssl rand -base64 32
#
# Si falta cualquiera de las dos, /api/site-auth responde 503 en vez de caer a
# una contraseña por defecto — no hay fallback "granvia2026". Cambiar
# SITE_SESSION_SECRET invalida todas las cookies de acceso ya emitidas.
SITE_PASSWORD=
SITE_SESSION_SECRET=

# ── Consola privada de asset management (/consola) ────────────────────────────
# Credenciales del formulario de acceso y secreto de firma de la cookie de sesión.
#
# Local: copia este archivo a .env.local y define valores reales.
# Producción: se configuran como variables de entorno del proyecto en Vercel
# (Project Settings → Environment Variables), nunca en el repo.
#
#   vercel env add CONSOLA_USER            production
#   vercel env add CONSOLA_PASSWORD        production
#   vercel env add CONSOLA_SESSION_SECRET  production
#
# Genera el secreto de firma (32 bytes aleatorios) con:
#   openssl rand -base64 32
#
# Si falta cualquiera de las tres, /consola responde 503 en vez de servir el
# rent roll sin protección. Cambiar CONSOLA_SESSION_SECRET invalida todas las
# sesiones activas.
CONSOLA_USER=
CONSOLA_PASSWORD=
CONSOLA_SESSION_SECRET=

# ── Supabase (Phase 0+) ────────────────────────────────────────────────────
# Service-role key only — read by src/lib/supabase/server.ts, which is
# marked "server-only" so it can never reach a client bundle. Do NOT prefix
# either of these with NEXT_PUBLIC_; that would ship the service-role key
# (which bypasses every RLS policy) to the browser.
#
# Local: values from the "Landlord OS Master" test project (thoofdklpbdnaicvommo).
# Production: values from Gran Via's own prod project, set as Vercel env vars
# — never the same project as staging, per root CLAUDE.md §5.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key — safe to be non-secret (it's what a browser would
# use anyway), but not currently NEXT_PUBLIC_-prefixed since only used by
# session-scoped server clients (src/lib/auth/server.ts, middleware.ts).
SUPABASE_ANON_KEY=
# Absolute URL invite emails redirect to (inviteUserByEmail requires a full
# URL, not a relative path). Production: the real Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=
# Same URL/anon key as above, NEXT_PUBLIC_-prefixed — the invite-acceptance
# page needs a browser client (src/lib/auth/browser.ts), and only
# NEXT_PUBLIC_ vars reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Anthropic (Phase 2+) ───────────────────────────────────────────────────
# Read by Diego's draft and skeptic passes (src/workflows/diego-triage.ts).
ANTHROPIC_API_KEY=

# ── Dev-only landlord auth bypass ──────────────────────────────────────────
# Lets a script/curl call any landlord-gated API route (e.g.
# /api/workflow/approve) without a real Supabase Auth session — needed
# because Workflow DevKit's local hook queue is tied to the live server
# process (see the session note that led to this), so testing a suspended
# workflow's approval/rejection from outside a browser needs some way in
# that isn't "log in by hand every time."
#
# Hard-gated in code (src/lib/auth/server.ts) on
# `process.env.NODE_ENV !== "production"` — that check is unconditional, not
# controlled by any env var, so this cannot fire on a real deploy even if
# these were somehow set there. Leave both unset in Vercel; set both only in
# .env.local.
#
# DEV_BYPASS_AUTH_TOKEN: any random string (e.g. `openssl rand -hex 24`).
#   Callers present it via the `x-dev-bypass-token` request header.
# DEV_BYPASS_PROFILE_ID: a real profiles.id (role='landlord') to impersonate
#   — profiles.id has a hard FK to auth.users(id), so this can't be an
#   arbitrary UUID. Create one with supabase.auth.admin.createUser() +
#   a matching profiles upsert; give it an unmistakable email/full_name
#   (e.g. "dev-bypass@local.test") so it's never confused with a real
#   landlord in an audit trail.
DEV_BYPASS_AUTH_TOKEN=
DEV_BYPASS_PROFILE_ID=
